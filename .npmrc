# Phase 8 — envoy-harness integration needs this file for pnpm 10+ on
# this machine. The user-level ~/.npmrc points to the Huawei mirror,
# which does not carry the private @envoymesh/* packages. Without
# `link-workspace-packages = true` and `prefer-workspace-packages = true`,
# pnpm 10 tries to fetch those packages from the mirror and 404s.
#
# The Huawei mirror stays as the registry for non-workspace deps; the
# two workspace flags make pnpm prefer the local packages/* symlinks.
#
# Cleanup: this is a Phase 8 follow-up. When the registry is updated
# or the workspace config is migrated to pnpm-workspace.yaml properly,
# this .npmrc can be deleted (the pnpm-workspace.yaml is the
# authoritative workspace config; the deprecated `workspaces` field
# in root package.json + this .npmrc pair is the bridge).

link-workspace-packages=true
prefer-workspace-packages=true

# The workspace uses `link:` protocol deps for the sibling envoy-harness
# packages, so pnpm is the effective package manager. EnvoyMesh's node
# code has long relied on npm-style flat hoisting (several modules import
# transitive deps without declaring them, e.g. mammoth/xlsx in home-fs.ts
# and @libp2p/* in libp2p-key-loader.ts). `shamefully-hoist` restores the
# flat root layout pnpm would otherwise remove, keeping `tsc` resolution
# working until those phantom deps are declared properly.
shamefully-hoist=true
