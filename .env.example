# EnvoyMesh environment overrides (reference template)
#
# Copy to .env at repo root (gitignored):
#   cp .env.example .env
#
# Precedence: node-config.json < YAML (--config) < .env < CLI flags
# Restart the node after changes.
#
# Full field guide: docs/local-configuration.reference.md

# --- Profile & vault ---

# Profile directory (keys, node-config.json, chat logs, RAG DB).
# Default: ./data/default (relative to apps/node when running npm run node:dev)
# ENVOYMESH_PROFILE=./data/default

# Vault root for knowledge files and file-share paths.
# Default: ./shared_vault (under apps/node)
# ENVOYMESH_VAULT=./shared_vault

# --- Discovery & WAN ---

# lan-fast | wan-default | relay-only | contacts-only
# ENVOYMESH_DISCOVERY_PROFILE=wan-default

# Comma-separated libp2p bootstrap multiaddrs (/ip4/.../tcp/.../p2p/...)
# ENVOYMESH_BOOTSTRAP_PEERS=/ip4/203.0.113.10/tcp/4001/p2p/12D3KooW...

# Comma-separated managed preset names: public-libp2p, cn-relay, public-libp2p-am6, ...
# ENVOYMESH_BOOTSTRAP_PRESETS=public-libp2p,cn-relay

# Comma-separated paths to custom preset YAML (see bootstrap-presets.example.yaml)
# ENVOYMESH_BOOTSTRAP_PRESETS_FILES=./bootstrap-presets.yaml

# Comma-separated reachable relay bases for relay.lookup (public IP or DNS, same port clients use)
# ENVOYMESH_ADVERTISE_ADDRS=/ip4/203.0.113.10/tcp/4001

# Set to 1 to fail startup when wan-default bootstrap connectivity cannot be established
# ENVOYMESH_CONNECTIVITY_STRICT=0

# Enable QUIC transport alongside TCP: 1 | true | yes  (or 0 | false | no to disable)
# ENVOYMESH_QUIC=0

# Log each libp2p peer discovery to console
# ENVOYMESH_PEER_DISCOVERY_LOG=0

# With --p2p-debug: print periodic relay connection manager summaries (very chatty)
# ENVOYMESH_RELAY_DEBUG_SUMMARY=0

# --- Chat LLM (overrides node-config.json modelProviders) ---

# mock | ollama | litellm | openai-compatible | anthropic-compatible | disabled
# ENVOY_MODEL_MODE=openai-compatible

# Chat API base URL (OpenAI-shaped providers: include /v1)
# ENVOY_MODEL_ENDPOINT=https://api.minimaxi.com/v1

# ENVOY_MODEL_API_KEY=your-api-key-here

# ENVOY_MODEL_NAME=MiniMax-M2.7

# Force chat draft assist on (true) regardless of node-config.json
# ENVOY_CHAT_ASSIST_ENABLED=false

# --- IPFS export (desktop node) ---

# kubo | helia | kubo-with-helia-shadow
# ENVOYMESH_IPFS_EXPORT_ENGINE=kubo

# Path to kubo/ipfs binary, or directory containing it
# ENVOYMESH_IPFS_EXE=
# ENVOYMESH_IPFS_PATH=

# Kubo HTTP API port (default 5001)
# ENVOYMESH_IPFS_API_PORT=5001

# Pinning provider JWT when externalPublish.pinningEnabled is true in node-config.json
# ENVOYMESH_PINATA_JWT=
# ENVOYMESH_WEB3_STORAGE_TOKEN=

# --- Relay binary (apps/relay) ---

# WebSocket auth token for relay clients
# ENVOYMESH_WS_AUTH_TOKEN=

# --- Integration tests only (not for normal operation) ---

# Public relay for relay-chat-e2e, wan-relay-signoff-e2e, agent-e2e-real, etc.
TEST_RELAY_ADDR=/ip4/47.93.11.212/tcp/4001/p2p/12D3KooWLNR4WYWHBswe8ux5zWsy6cuGywnYPJbdbaAbbpmJMjbo

# Local relay instead: ./scripts/run-relay.sh --profile ./data/test-relay-e2e --advertise 127.0.0.1 --http-port 8080
# TEST_RELAY_ADDR=/ip4/127.0.0.1/tcp/4001/p2p/12D3KooW...

# agent-e2e-real only: opt in when TEST_RELAY_ADDR is unset (same public relay default)
# RUN_E2E_RELAY_TESTS=1

# Set to 1 to run Kubo CLI integration tests (requires ipfs on PATH + daemon)
# ENVOYMESH_IPFS_CLI_TEST=0

# Set to 1 with Kubo for Helia/Kubo CID parity tests
# ENVOYMESH_HELIA_PARITY_TEST=0
