{
  "$id": "https://envoymesh.dev/schemas/emp-0.1/discovery-request-payload.json",
  "title": "discovery.request Payload",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requesterOwnerId": {
      "type": "string",
      "minLength": 1
    },
    "requestedTagHashes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requestedCapabilities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maxResults": {
      "default": 5,
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "requestedSensitivity": {
      "type": "string",
      "enum": [
        "public",
        "friends",
        "private"
      ]
    },
    "fileTitleQuery": {
      "type": "string",
      "maxLength": 200
    },
    "requestedContentHashPrefixes": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 128
      }
    },
    "maxHops": {
      "default": 1,
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "currentHop": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "forwardPrivacy": {
      "default": "none",
      "type": "string",
      "enum": [
        "none",
        "anonymous"
      ]
    },
    "referralOwnerId": {
      "type": "string",
      "minLength": 1
    },
    "referralAttestation": {
      "type": "object",
      "properties": {
        "referralOwnerId": {
          "type": "string",
          "minLength": 1
        },
        "requestMessageId": {
          "type": "string",
          "minLength": 1
        },
        "correlationId": {
          "type": "string",
          "minLength": 1
        },
        "anonymizedRequesterId": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "referralOwnerId",
        "requestMessageId",
        "anonymizedRequesterId",
        "signature"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "requesterOwnerId",
    "requestedTagHashes",
    "requestedCapabilities",
    "maxResults",
    "maxHops",
    "currentHop",
    "forwardPrivacy"
  ],
  "additionalProperties": false
}
