{
  "$id": "https://envoymesh.dev/schemas/emp-0.1/unsigned-envelope.json",
  "title": "Unsigned EMP Envelope",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "0.1"
    },
    "messageId": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "senderPeerId": {
      "type": "string",
      "minLength": 1
    },
    "senderPublicKey": {
      "type": "string",
      "minLength": 1
    },
    "senderRole": {
      "type": "string",
      "enum": [
        "human",
        "agent",
        "system"
      ]
    },
    "recipientPeerId": {
      "type": "string",
      "minLength": 1
    },
    "recipientRole": {
      "type": "string",
      "enum": [
        "human",
        "agent",
        "system"
      ]
    },
    "intent": {
      "type": "string",
      "enum": [
        "system.ping",
        "system.signal",
        "agent.card.request",
        "agent.card.response",
        "auth.challenge",
        "auth.challenge.response",
        "bond.request",
        "bond.accept",
        "bond.challenge",
        "bond.challenge.response",
        "discovery.request",
        "discovery.response",
        "relay.peers.request",
        "relay.peers.response",
        "relay.checkin",
        "relay.lookup",
        "relay.lookup.response",
        "relay.hints.request",
        "relay.hints.response",
        "relay.join.request",
        "relay.join.response",
        "relay.register",
        "relay.register.response",
        "relay.summary",
        "chat.message",
        "chat.delivered",
        "knowledge.query",
        "knowledge.response",
        "task.mandate",
        "task.propose",
        "task.negotiate",
        "task.accept",
        "task.reject",
        "task.cancel",
        "task.heartbeat",
        "task.result",
        "report.create",
        "sync.state",
        "device.pair.request",
        "device.pair.approve",
        "device.pair.deferred",
        "rendezvous.register",
        "rendezvous.query",
        "rendezvous.response",
        "share.preview",
        "share.request",
        "share.accept",
        "social.intro.owner-ready",
        "social.intro.propose",
        "social.intro.sync",
        "broadcast.request",
        "broadcast.response",
        "broadcast.cancel",
        "task.feedback",
        "official.credential",
        "profile.sync",
        "profile.request",
        "profile.response"
      ]
    },
    "payload": {},
    "agentCredential": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "0.1"
        },
        "credentialId": {
          "type": "string",
          "minLength": 1
        },
        "ownerId": {
          "type": "string",
          "minLength": 1
        },
        "ownerPublicKeyPem": {
          "type": "string",
          "minLength": 1
        },
        "agentId": {
          "type": "string",
          "minLength": 1
        },
        "agentPeerId": {
          "type": "string",
          "minLength": 1
        },
        "agentPublicKeyPem": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "signature": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version",
        "credentialId",
        "ownerId",
        "ownerPublicKeyPem",
        "agentId",
        "agentPeerId",
        "agentPublicKeyPem",
        "scope",
        "issuedAt",
        "expiresAt",
        "signature"
      ],
      "additionalProperties": false
    },
    "postureRef": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "version",
    "messageId",
    "createdAt",
    "senderPeerId",
    "senderPublicKey",
    "senderRole",
    "recipientRole",
    "intent",
    "payload"
  ],
  "additionalProperties": false
}
