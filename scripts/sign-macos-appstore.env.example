# Copy to scripts/sign-macos-appstore.env (gitignored) for MAC_APP_STORE=1 builds.
#
# Prerequisites (App Store Connect + Apple Developer):
#   1. Register App ID dev.envoymesh.desktop (must match tauri.conf.json identifier).
#   2. Create "Mac App Store Connect" provisioning profile → download as .provisionprofile.
#   3. Certificates: Apple Distribution (app) + Mac Installer Distribution (pkg).
#
#   security find-identity -v -p codesigning
#
# Place the provisioning profile path in MAC_APPSTORE_PROVISION_PROFILE (copied into
# apps/tauri/src-tauri/EnvoyMesh_AppStore.provisionprofile before build).

export APPLE_TEAM_ID="XXXXXXXXXX"
export APPLE_SIGNING_IDENTITY="Apple Distribution: Your Name (XXXXXXXXXX)"
export MAC_APPSTORE_PKG_SIGNING_IDENTITY="3rd Party Mac Developer Installer: Your Name (XXXXXXXXXX)"
export MAC_APPSTORE_PROVISION_PROFILE="/path/to/EnvoyMesh_AppStore.provisionprofile"

# Upload .pkg after build (optional — App Store Connect API key):
# export APPLE_API_KEY="ABCD1234"
# export APPLE_API_ISSUER="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# xcrun altool --upload-app --type macos --file release/envoymesh-desktop-appstore-0.3.0.pkg \
#   --apiKey "$APPLE_API_KEY" --apiIssuer "$APPLE_API_ISSUER"
