{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "jsx": "react-jsx",
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "..",
    "paths": {
      "@envoymesh/social/*": ["../social/src/*"]
    }
  },
  "include": ["capacitor.config.ts", "src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "../social/src/**/*.ts", "../social/src/**/*.tsx", "../social/src/**/*.d.ts"],
  "references": [
    { "path": "../../packages/protocol" },
    { "path": "../../packages/api" },
    { "path": "../../packages/mobile-identity" },
    { "path": "../../packages/mobile-storage" },
    { "path": "../../packages/mobile-vault" },
    { "path": "../../packages/mobile-node" }
  ]
}
