{
  "name": "@envoymesh/mobile",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "cap:sync": "npx cap sync && node ../../scripts/cap-sync-patch.cjs",
    "cap:ios": "npx cap add ios",
    "cap:android": "npx cap add android",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor-community/barcode-scanner": "^3.0.3",
    "@capacitor-community/sqlite": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@envoymesh/api": "0.1.0",
    "@envoymesh/mobile-identity": "0.1.0",
    "@envoymesh/mobile-node": "0.1.0",
    "@envoymesh/mobile-storage": "0.1.0",
    "@envoymesh/mobile-vault": "0.1.0",
    "@envoymesh/protocol": "0.1.0",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0"
  },
  "comments": {
    "plugins": "Additional Capacitor plugins to install when building: @capacitor/android, @capacitor/ios, @capacitor/filesystem, @capacitor/geolocation, @capacitor/preferences, @capacitor-community/sqlite, @capacitor-community/barcode-scanner, capacitor-secure-storage-plugin"
  }
}
