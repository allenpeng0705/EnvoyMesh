{
  "name": "@envoymesh/node",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "bin": {
    "envoy-node": "./dist/src/index.js",
    "envoyctl": "./dist/src/cli.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "node:dev": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "connectivity:smoke": "tsx src/connectivity-smoke.ts",
    "poc:discovery": "tsx src/connectivity-smoke.ts",
    "poc:discovery:mdns": "tsx src/connectivity-smoke.ts --mode mdns --timeout-ms 20000",
    "poc:discovery:advanced-public": "tsx src/connectivity-smoke.ts --mode advanced --bootstrap /dnsaddr/bootstrap.libp2p.io/p2p/QmNnooDu7bfjPFoTZYxMNLWUQJyrVwtbZg5gBMjTezGAJN --timeout-ms 60000",
    "poc:discovery:relay-public": "tsx src/connectivity-smoke.ts --mode advanced --bootstrap /dnsaddr/bootstrap.libp2p.io/p2p/QmNnooDu7bfjPFoTZYxMNLWUQJyrVwtbZg5gBMjTezGAJN --expect-relay-address --timeout-ms 90000",
    "social:challenge": "tsx src/social-challenge.ts",
    "smoke:local-two-node": "tsx src/local-two-node-smoke.ts",
    "discovery:dashboard": "tsx src/discovery-dashboard.ts",
    "discovery:dashboard:wan": "tsx src/discovery-dashboard.ts --profile ./data/default --discovery-profile wan-default --bootstrap-preset public-libp2p --p2p-debug"
  },
  "dependencies": {
    "@envoymesh/api": "0.1.0",
    "@envoymesh/bonds": "0.1.0",
    "@envoymesh/identity": "0.1.0",
    "@envoymesh/local-store": "0.1.0",
    "@envoymesh/models": "0.1.0",
    "@envoymesh/network": "0.1.0",
    "@envoymesh/protocol": "0.1.0",
    "@envoymesh/vault": "0.1.0",
    "ws": "^8.20.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0"
  }
}
