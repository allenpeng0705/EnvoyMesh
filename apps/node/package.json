{
  "name": "@envoymesh/node",
  "version": "0.3.0",
  "type": "module",
  "private": true,
  "bin": {
    "envoy-node": "./dist/src/index.js",
    "envoyctl": "./dist/src/cli.js"
  },
  "scripts": {
    "dev": "tsc -b ../../packages/api && tsx src/index.ts",
    "node:dev": "tsc -b ../../packages/api && tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "connectivity:smoke": "tsx src/connectivity-smoke.ts",
    "poc:discovery": "tsx src/connectivity-smoke.ts",
    "poc:discovery:mdns": "tsx src/connectivity-smoke.ts --mode mdns --timeout-ms 20000",
    "poc:discovery:advanced-public": "tsx src/connectivity-smoke.ts --mode advanced --bootstrap /dnsaddr/bootstrap.libp2p.io/p2p/QmNnooDu7bfjPFoTZYxMNLWUQJyrVwtbZg5gBMjTezGAJN --timeout-ms 60000",
    "poc:discovery:relay-public": "tsx src/connectivity-smoke.ts --mode advanced --bootstrap /dnsaddr/bootstrap.libp2p.io/p2p/QmNnooDu7bfjPFoTZYxMNLWUQJyrVwtbZg5gBMjTezGAJN --expect-relay-address --timeout-ms 90000",
    "social:challenge": "tsx src/social-challenge.ts",
    "smoke:local-two-node": "tsx src/local-two-node-smoke.ts",
    "smoke:phase13-two-node": "tsx src/phase13-two-node-smoke.ts",
    "smoke:openclaw-bridge": "tsx src/openclaw-bridge-smoke/orchestrator.ts",
    "smoke:openclaw-bridge:live": "OPENCLAW_BRIDGE_SMOKE_LIVE=1 tsx src/openclaw-bridge-smoke/orchestrator.ts",
    "discovery:dashboard": "tsx src/discovery-dashboard.ts",
    "discovery:dashboard:wan": "tsx src/discovery-dashboard.ts --profile ./data/default --discovery-profile wan-default --bootstrap-preset public-libp2p --p2p-debug"
  },
  "dependencies": {
    "@envoymesh/api": "0.3.0",
    "@envoymesh/agent-adapter": "0.3.0",
    "@envoymesh/bonds": "0.3.0",
    "@envoymesh/envoy-harness": "file:../../../envoy-harness/packages/envoy-harness",
    "@envoymesh/envoy-harness-client": "file:../../../envoy-harness/packages/envoy-harness-client",
    "@envoymesh/envoy-harness-adapter": "file:../../../envoy-harness/packages/envoy-harness-adapter",
    "@envoymesh/envoy-harness-peer": "file:../../../envoy-harness/packages/envoy-harness-peer",
    "@envoymesh/identity": "0.3.0",
    "@envoymesh/ipfs-helia": "0.3.0",
    "@envoymesh/kb-obsidian": "0.3.0",
    "@envoymesh/local-store": "0.3.0",
    "@envoymesh/models": "0.3.0",
    "@envoymesh/network": "0.3.0",
    "@envoymesh/openclaw-runtime": "0.3.0",
    "@envoymesh/protocol": "0.3.0",
    "@envoymesh/rag": "0.3.0",
    "@envoymesh/vault": "0.3.0",
    "@libp2p/utils": "^7.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "nat-upnp": "^1.1.1",
    "@anthropic-ai/claude-agent-sdk": "^0.3.156",
    "node-pty": "^1.1.0",
    "sharp": "^0.35.3",
    "ws": "^8.20.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/nat-upnp": "^1.1.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0"
  }
}
