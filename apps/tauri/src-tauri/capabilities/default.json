{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capabilities for EnvoyMesh",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "updater:default",
    "process:default",
    "allow-restart-node-process",
    "allow-stop-node-process",
    "allow-app-logs"
  ]
}