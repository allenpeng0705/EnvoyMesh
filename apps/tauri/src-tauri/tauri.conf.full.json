{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EnvoyMesh",
  "version": "0.1.0",
  "identifier": "dev.envoymesh.desktop",
  "build": {
    "frontendDist": "../../social/src/dist",
    "devUrl": null,
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "EnvoyMesh",
        "width": 1280,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/node/**/*",
      "resources/node-runtime/**/*",
      "resources/openclaw/**/*",
      "resources/kubo/**/*",
      "!resources/openclaw/src/**",
      "!resources/openclaw/apps/**",
      "!resources/openclaw/docs/**",
      "!resources/openclaw/qa/**",
      "!resources/openclaw/test/**",
      "!resources/openclaw/packages/**",
      "!resources/openclaw/scripts/**",
      "!resources/openclaw/ui/**",
      "!resources/openclaw/config/**",
      "!resources/openclaw/data/**",
      "!resources/openclaw/deploy/**",
      "!resources/openclaw/git-hooks/**"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
