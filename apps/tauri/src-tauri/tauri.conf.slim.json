{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EnvoyMesh",
  "version": "0.1.0",
  "identifier": "dev.envoymesh.app",
  "build": {
    "frontendDist": "../../social/src/dist",
    "devUrl": null,
    "beforeDevCommand": "",
    "beforeBuildCommand": "bash ../../scripts/fetch-node-sidecar.sh && bash ../../scripts/stage-tauri-openclaw-bundle.sh && bash ../../scripts/stage-tauri-node-bundle.sh"
  },
  "app": {
    "windows": [
      {
        "title": "EnvoyMesh",
        "width": 1280,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/node/**/*",
      "resources/node-runtime/**/*",
      "resources/openclaw/**/*"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
