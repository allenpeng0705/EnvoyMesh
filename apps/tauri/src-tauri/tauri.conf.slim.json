{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EnvoyMesh",
  "version": "0.1.0",
  "identifier": "dev.envoymesh.desktop",
  "build": {
    "frontendDist": "../../social/src/dist",
    "devUrl": null,
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "EnvoyMesh",
        "width": 1280,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/node/**/*",
      "resources/node-runtime/**/*",
      "resources/openclaw/openclaw.mjs",
      "resources/openclaw/package.json",
      "resources/openclaw/npm-shrinkwrap.json",
      "resources/openclaw/pnpm-lock.yaml",
      "resources/openclaw/tsconfig*.json",
      "resources/openclaw/tsdown.config.ts",
      "resources/openclaw/vitest.config.ts",
      "resources/openclaw/patches/**/*",
      "resources/openclaw/skills/**/*",
      "resources/openclaw/security/**/*",
      "resources/openclaw/dist/**/*",
      "resources/openclaw/dist-runtime/**/*",
      "resources/openclaw/extensions/envoymesh/**/*",
      "resources/openclaw/extensions/duckduckgo/**/*",
      "resources/openclaw/extensions/brave/**/*",
      "resources/openclaw/extensions/exa/**/*",
      "resources/openclaw/extensions/firecrawl/**/*",
      "resources/openclaw/extensions/google/**/*",
      "resources/openclaw/extensions/xai/**/*",
      "resources/openclaw/extensions/moonshot/**/*",
      "resources/openclaw/extensions/minimax/**/*",
      "resources/openclaw/extensions/ollama/**/*",
      "resources/openclaw/extensions/perplexity/**/*",
      "resources/openclaw/extensions/searxng/**/*",
      "resources/openclaw/extensions/tavily/**/*",
      "resources/openclaw/node_modules/**/*"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
