{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EnvoyMesh",
  "version": "0.1.0",
  "identifier": "dev.envoymesh.app",
  "build": {
    "frontendDist": "../../social/src/dist",
    "devUrl": null,
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "EnvoyMesh",
        "width": 1280,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}