{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EnvoyMesh",
  "version": "0.2.2",
  "identifier": "dev.envoymesh.desktop",
  "build": {
    "frontendDist": "../../social/src/dist",
    "devUrl": null,
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "EnvoyMesh",
        "width": 1280,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/node/**/*",
      "resources/node-runtime/**/*",
      "resources/openclaw/**/*",
      "resources/pi/**/*"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4REEzQkU1MTdGM0NBMjkKUldRcHl2TVg1VHZhdVA0RDFPalFvTE1YRWRtd2wzSGpzcUU0aDZQNlN4Q2xzK0M5REgrYy9ZSk0K",
      "endpoints": [
        "https://github.com/allenpeng0705/EnvoyMesh/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
