{
  "name": "@envoymesh/desktop",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/main/main.cjs",
  "scripts": {
    "dev": "npm run build && electron ./dist/main/main.cjs",
    "build": "npm run build:main && vite build",
    "build:main": "tsc -b ../../packages/local-store ../../packages/vault && esbuild src/main/main.ts --bundle --platform=node --format=cjs --outfile=dist/main/main.cjs --external:electron && esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --outfile=dist/preload/preload.cjs --external:electron",
    "dist": "npm run build && electron-builder --config electron-builder.yml",
    "dist:mac": "npm run build && electron-builder --config electron-builder.yml --mac",
    "dist:win": "npm run build && electron-builder --config electron-builder.yml --win",
    "dist:linux": "npm run build && electron-builder --config electron-builder.yml --linux"
  },
  "dependencies": {
    "@envoymesh/identity": "0.1.0",
    "@envoymesh/local-store": "0.1.0",
    "@envoymesh/network": "0.1.0",
    "@envoymesh/protocol": "0.1.0",
    "@envoymesh/vault": "0.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^39.2.7",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.27.2",
    "vite": "^7.3.0"
  }
}
