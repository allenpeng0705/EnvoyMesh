{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@envoymesh/protocol": ["./packages/protocol/src/index.ts"],
      "@envoymesh/identity": ["./packages/identity/src/index.ts"],
      "@envoymesh/bonds": ["./packages/bonds/src/index.ts"],
      "@envoymesh/network/capability-topic-cid": ["./packages/network/src/capability-topic-cid.ts"],
      "@envoymesh/network/protocols": ["./packages/network/src/protocols.ts"],
      "@envoymesh/network/data-framing": ["./packages/network/src/data-framing.ts"],
      "@envoymesh/network": ["./packages/network/src/index.ts"],
      "@envoymesh/vault": ["./packages/vault/src/index.ts"],
      "@envoymesh/models": ["./packages/models/src/index.ts"],
    "@envoymesh/local-store": ["./packages/local-store/src/index.ts"],
    "@envoymesh/api": ["./packages/api/src/index.ts"],
      "@envoymesh/ipfs-helia": ["./packages/ipfs-helia/src/index.ts"],
      "@envoymesh/ipfs-helia/browser": ["./packages/ipfs-helia/src/browser.ts"],
      "@envoymesh/mobile-identity": ["./packages/mobile-identity/src/index.ts"],
      "@envoymesh/mobile-storage": ["./packages/mobile-storage/src/index.ts"],
      "@envoymesh/mobile-vault": ["./packages/mobile-vault/src/index.ts"],
      "@envoymesh/mobile-node": ["./packages/mobile-node/src/index.ts"],
    "@envoymesh/rag": ["./packages/rag/src/index.ts"]
    },
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true
  }
}
